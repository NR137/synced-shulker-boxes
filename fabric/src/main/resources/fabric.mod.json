{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "${mod_name}",
	"description": "Link shulker boxes so they share one inventory. Server-side: players join with an unmodded client; with the mod on the client too, synced boxes get the enchantment glint. Not an official Minecraft product. Not approved by or associated with Mojang or Microsoft.",
	"authors": [
		"NR137"
	],
	"contact": {
		"homepage": "${mod_homepage}",
		"sources": "${mod_homepage}",
		"issues": "${mod_homepage}/issues"
	},
	"license": "${license}",
	"environment": "*",
	"entrypoints": {
		"main": [
			"de.nr137.syncedshulkerboxes.fabric.SyncedShulkerBoxesFabric"
		],
		"client": [
			"de.nr137.syncedshulkerboxes.fabric.SyncedShulkerBoxesFabricClient"
		],
		"modmenu": [
			"de.nr137.syncedshulkerboxes.fabric.ModMenuIntegration"
		]
	},
	"mixins": [
		"${mod_id}.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}
