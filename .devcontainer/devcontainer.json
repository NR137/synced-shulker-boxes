// VS Code: "Dev Containers: Reopen in Container". The editor stays on your machine; terminal, Gradle, Java, Python and
// the tests run in the dev image (docker/Dockerfile), with the cache of compose.yaml.
{
	"name": "Synced Shulker Boxes",
	"dockerComposeFile": ["../compose.yaml"],
	"service": "dev",
	"workspaceFolder": "/workspace",
	// Keeps the container running while VS Code is attached.
	"overrideCommand": true,
	"remoteUser": "dev",
	// Gives the container user your user's IDs if they differ from the image's 1000.
	"updateRemoteUserUID": true,
	// The dev server's game port; others are forwarded when used.
	"forwardPorts": [25565],
	"postCreateCommand": "git config core.hooksPath .githooks",
	"customizations": {
		"vscode": {
			"extensions": [
				"vscjava.vscode-java-pack",
				"vscjava.vscode-gradle",
				"ms-python.python",
				"github.vscode-github-actions"
			],
			"settings": {
				"java.import.gradle.enabled": true,
				"java.configuration.updateBuildConfiguration": "automatic"
			}
		}
	}
}
